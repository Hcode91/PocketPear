+// VADDHN/VRADDHN/VSUBHN/VRSUBHN: the high half of each sum (or difference) of two wide
+// vectors, optionally rounded, narrowed into a doubleword.
+static bool NarrowingHighHalf(TranslatorVisitor& v, bool D, size_t sz, size_t Vn, size_t Vd, bool N, bool M, size_t Vm, bool subtract, bool round) {
+    if (sz == 0b11) {
+        return v.DecodeError();
+    }
+
+    if (mcl::bit::get_bit<0>(Vn) || mcl::bit::get_bit<0>(Vm)) {
+        return v.UndefinedInstruction();
+    }
+
+    const size_t esize = 8U << sz;
+    const auto d = ToVector(false, Vd, D);
+    const auto n = ToVector(true, Vn, N);
+    const auto m = ToVector(true, Vm, M);
+
+    const auto reg_n = v.ir.GetVector(n);
+    const auto reg_m = v.ir.GetVector(m);
+    auto wide = subtract ? v.ir.VectorSub(esize * 2, reg_n, reg_m) : v.ir.VectorAdd(esize * 2, reg_n, reg_m);
+    if (round) {
+        wide = v.ir.VectorAdd(esize * 2, wide, v.ir.VectorBroadcast(esize * 2, v.I(esize * 2, u64(1) << (esize - 1))));
+    }
+    const auto high = v.ir.VectorLogicalShiftRight(esize * 2, wide, static_cast<u8>(esize));
+    v.ir.SetVector(d, v.ir.VectorNarrow(esize * 2, high));
+    return true;
+}
+
+bool TranslatorVisitor::asimd_VADDHN(bool D, size_t sz, size_t Vn, size_t Vd, bool N, bool M, size_t Vm) {
+    return NarrowingHighHalf(*this, D, sz, Vn, Vd, N, M, Vm, false, false);
+}
+
+bool TranslatorVisitor::asimd_VRADDHN(bool D, size_t sz, size_t Vn, size_t Vd, bool N, bool M, size_t Vm) {
+    return NarrowingHighHalf(*this, D, sz, Vn, Vd, N, M, Vm, false, true);
+}
+
+bool TranslatorVisitor::asimd_VSUBHN(bool D, size_t sz, size_t Vn, size_t Vd, bool N, bool M, size_t Vm) {
+    return NarrowingHighHalf(*this, D, sz, Vn, Vd, N, M, Vm, true, false);
+}
+
+bool TranslatorVisitor::asimd_VRSUBHN(bool D, size_t sz, size_t Vn, size_t Vd, bool N, bool M, size_t Vm) {
+    return NarrowingHighHalf(*this, D, sz, Vn, Vd, N, M, Vm, true, true);
+}
+
+bool TranslatorVisitor::asimd_VQDMULL(bool D, size_t sz, size_t Vn, size_t Vd, bool N, bool M, size_t Vm) {
+    if (sz == 0b11) {
+        return DecodeError();
+    }
+
+    if (sz == 0b00 || mcl::bit::get_bit<0>(Vd)) {
+        return UndefinedInstruction();
+    }
+
+    const size_t esize = 8U << sz;
+    const auto d = ToVector(true, Vd, D);
+    const auto n = ToVector(false, Vn, N);
+    const auto m = ToVector(false, Vm, M);
+
+    const auto result = ir.VectorSignedSaturatedDoublingMultiplyLong(esize, ir.GetVector(n), ir.GetVector(m));
+    ir.SetVector(d, result);
+    return true;
+}
+
+bool TranslatorVisitor::asimd_VQDMLAL(bool D, size_t sz, size_t Vn, size_t Vd, bool op, bool N, bool M, size_t Vm) {
+    if (sz == 0b11) {
+        return DecodeError();
+    }
+
+    if (sz == 0b00 || mcl::bit::get_bit<0>(Vd)) {
+        return UndefinedInstruction();
+    }
+
+    const size_t esize = 8U << sz;
+    const auto d = ToVector(true, Vd, D);
+    const auto n = ToVector(false, Vn, N);
+    const auto m = ToVector(false, Vm, M);
+
+    const auto product = ir.VectorSignedSaturatedDoublingMultiplyLong(esize, ir.GetVector(n), ir.GetVector(m));
+    const auto reg_d = ir.GetVector(d);
+    const auto result = op ? ir.VectorSignedSaturatedSub(esize * 2, reg_d, product)
+                           : ir.VectorSignedSaturatedAdd(esize * 2, reg_d, product);
+    ir.SetVector(d, result);
+    return true;
+}
+
 bool TranslatorVisitor::asimd_VABAL(bool U, bool D, size_t sz, size_t Vn, size_t Vd, bool N, bool M, size_t Vm) {
     return AbsoluteDifferenceLong(*this, U, D, sz, Vn, Vd, N, M, Vm, AccumulateBehavior::Accumulate);
 }
